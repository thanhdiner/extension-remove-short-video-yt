{
  "manifest_version": 3,
  "name": "Hide YouTube Shorts",
  "version": "1.0.0",
  "description": "Ẩn toàn bộ YouTube Shorts và chặn các URL /shorts/.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequest", "tabs", "scripting"],
  "host_permissions": [
    "*://www.youtube.com/*", 
    "*://m.youtube.com/*",
    "https://notebooklm.google.com/*",
    "https://*.notebooklm.google.com/*"
  ],
  "action": {
    "default_title": "Hide Shorts",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["nonstop.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://*.notebooklm.google.com/*"
      ],
      "js": ["content-notebook.js"],
      "css": ["content-notebook.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-altscroll.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": []
  }
}
