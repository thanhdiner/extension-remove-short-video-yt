{
  "name": "dinkit",
  "version": "1.0.0",
  "description": "Chrome Extension giúp bạn ẩn hoàn toàn sự xuất hiện của YouTube Shorts trên giao diện YouTube, tự động chặn/chuyển hướng các đường dẫn Shorts thành trình phát thường, đồng thời tích hợp phím tắt thay đổi tốc độ video cực kỳ tiện lợi và mượt mà.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests",
    "test:native": "node --test editor/tests",
    "test:browser": "py -3.12 scripts/run-browser-tests.py",
    "check": "node scripts/audit-extension.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  },
  "private": true
}
